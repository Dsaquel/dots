void cull() {
    gl_Position = vec4(2.0, 2.0, 2.0, 1.0);
    v_uv = vec2(0.0);
    v_n = vec2(0.0);
    v_lat = vec2(0.0);
    v_shard = vec4(0.0);
    v_glow = vec4(0.0);
    v_size = vec3(0.0);
    v_edge = 0.0;
    v_new = vec2(0.0);
    v_front = 0.0;
    v_mix = vec2(0.0);
    v_lift = vec4(0.0);
    v_out = vec2(0.0);
    v_ray = vec2(0.0);
}
